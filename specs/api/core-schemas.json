{
  "Problem": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "type": {
        "type": "string"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "integer"
      },
      "code": {
        "type": "string",
        "minLength": 1
      },
      "correlationId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "type",
      "title",
      "status",
      "code",
      "correlationId"
    ]
  },
  "Assignment": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "classId": {
        "type": "string",
        "format": "uuid"
      },
      "experimentId": {
        "type": "string",
        "format": "uuid"
      },
      "experimentVersion": {
        "type": "string",
        "minLength": 1
      },
      "rubricVersion": {
        "type": "string",
        "minLength": 1
      },
      "dueAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "classId",
      "experimentId",
      "experimentVersion",
      "rubricVersion",
      "dueAt"
    ]
  },
  "AssignmentPage": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Assignment"
        }
      },
      "nextCursor": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "items",
      "nextCursor"
    ]
  },
  "CreateAttempt": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "assignmentId": {
        "type": "string",
        "format": "uuid"
      },
      "deviceId": {
        "type": "string",
        "format": "uuid"
      },
      "experimentVersion": {
        "type": "string",
        "minLength": 1
      },
      "rubricVersion": {
        "type": "string",
        "minLength": 1
      },
      "modelVersion": {
        "type": "string",
        "minLength": 1
      },
      "schemaVersion": {
        "type": "integer",
        "minimum": 1
      },
      "clientVersion": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "assignmentId",
      "deviceId",
      "experimentVersion",
      "rubricVersion",
      "modelVersion",
      "schemaVersion",
      "clientVersion"
    ]
  },
  "Attempt": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "revision": {
        "type": "integer",
        "minimum": 0
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "provisional",
          "finalized"
        ]
      }
    },
    "required": [
      "id",
      "revision",
      "status"
    ]
  },
  "Command": {
    "oneOf": [
      {
        "$ref": "#/components/schemas/TransferCommand"
      },
      {
        "$ref": "#/components/schemas/SetResistanceCommand"
      },
      {
        "$ref": "#/components/schemas/ConnectCommand"
      }
    ]
  },
  "TransferCommand": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "type": {
        "const": "transfer"
      },
      "sourceVesselId": {
        "type": "string",
        "format": "uuid"
      },
      "targetVesselId": {
        "type": "string",
        "format": "uuid"
      },
      "volumeL": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "type",
      "sourceVesselId",
      "targetVesselId",
      "volumeL"
    ]
  },
  "SetResistanceCommand": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "type": {
        "const": "setResistance"
      },
      "componentId": {
        "type": "string",
        "format": "uuid"
      },
      "resistanceOhm": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "required": [
      "type",
      "componentId",
      "resistanceOhm"
    ]
  },
  "ConnectCommand": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "type": {
        "const": "connect"
      },
      "startTerminalId": {
        "type": "string",
        "format": "uuid"
      },
      "endTerminalId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "type",
      "startTerminalId",
      "endTerminalId"
    ]
  },
  "Event": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "eventId": {
        "type": "string",
        "format": "uuid"
      },
      "sequence": {
        "type": "integer",
        "minimum": 1
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0
      },
      "occurredAt": {
        "type": "string",
        "format": "date-time"
      },
      "modelVersion": {
        "type": "string",
        "minLength": 1
      },
      "schemaVersion": {
        "type": "integer",
        "minimum": 1
      },
      "payloadHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "command": {
        "$ref": "#/components/schemas/Command"
      }
    },
    "required": [
      "eventId",
      "sequence",
      "expectedRevision",
      "occurredAt",
      "modelVersion",
      "schemaVersion",
      "payloadHash",
      "command"
    ]
  },
  "EventBatch": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "requestId": {
        "type": "string",
        "format": "uuid"
      },
      "events": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "$ref": "#/components/schemas/Event"
        }
      }
    },
    "required": [
      "requestId",
      "events"
    ]
  },
  "EventAck": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "eventId": {
        "type": "string",
        "format": "uuid"
      },
      "status": {
        "type": "string",
        "enum": [
          "accepted",
          "duplicate",
          "missing_predecessor",
          "conflict",
          "unsupported_version",
          "rejected"
        ]
      },
      "revision": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "code": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "eventId",
      "status",
      "revision",
      "code"
    ]
  },
  "BatchAck": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "requestId": {
        "type": "string",
        "format": "uuid"
      },
      "results": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/EventAck"
        }
      }
    },
    "required": [
      "requestId",
      "results"
    ]
  }
}
