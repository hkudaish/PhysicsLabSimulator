{
  "openapi": "3.1.0",
  "info": {
    "title": "Virtual STEM Laboratory — initial draft",
    "version": "0.1.0",
    "description": "Phase 0 design only. No application routes implemented. Command catalog and other module routes incomplete."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/assignments": {
      "get": {
        "operationId": "listAssignments",
        "description": "Authenticated learner own assignments or teacher authorized class only. Server derives tenant from membership.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignmentPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid envelope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Revision or idempotency conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unsupported schema or command",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/attempts": {
      "post": {
        "operationId": "createAttempt",
        "description": "Assigned learner only. Actor and tenant derived from token; device authorization required.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAttempt"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created or original idempotent response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid envelope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Revision or idempotency conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unsupported schema or command",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/attempts/{attemptId}/events": {
      "post": {
        "operationId": "syncAttemptEvents",
        "description": "Attempt owner only; request cap proposed 1 MiB. Per-event results; retain rejected events locally. Command union is partial pending Phase 2 contract completion.",
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Explicit per-event acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchAck"
                }
              }
            }
          },
          "400": {
            "description": "Invalid envelope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Revision or idempotency conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unsupported schema or command",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ]
      },
      "Assignment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "classId": {
            "type": "string",
            "format": "uuid"
          },
          "experimentId": {
            "type": "string",
            "format": "uuid"
          },
          "experimentVersion": {
            "type": "string",
            "minLength": 1
          },
          "rubricVersion": {
            "type": "string",
            "minLength": 1
          },
          "dueAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "classId",
          "experimentId",
          "experimentVersion",
          "rubricVersion",
          "dueAt"
        ]
      },
      "AssignmentPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Assignment"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreateAttempt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "experimentVersion": {
            "type": "string",
            "minLength": 1
          },
          "rubricVersion": {
            "type": "string",
            "minLength": 1
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "clientVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "assignmentId",
          "deviceId",
          "experimentVersion",
          "rubricVersion",
          "modelVersion",
          "schemaVersion",
          "clientVersion"
        ]
      },
      "Attempt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "provisional",
              "finalized"
            ]
          }
        },
        "required": [
          "id",
          "revision",
          "status"
        ]
      },
      "Command": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TransferCommand"
          },
          {
            "$ref": "#/components/schemas/SetResistanceCommand"
          },
          {
            "$ref": "#/components/schemas/ConnectCommand"
          }
        ]
      },
      "TransferCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "transfer"
          },
          "sourceVesselId": {
            "type": "string",
            "format": "uuid"
          },
          "targetVesselId": {
            "type": "string",
            "format": "uuid"
          },
          "volumeL": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "type",
          "sourceVesselId",
          "targetVesselId",
          "volumeL"
        ]
      },
      "SetResistanceCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "setResistance"
          },
          "componentId": {
            "type": "string",
            "format": "uuid"
          },
          "resistanceOhm": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "type",
          "componentId",
          "resistanceOhm"
        ]
      },
      "ConnectCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "connect"
          },
          "startTerminalId": {
            "type": "string",
            "format": "uuid"
          },
          "endTerminalId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "startTerminalId",
          "endTerminalId"
        ]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "payloadHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          }
        },
        "required": [
          "eventId",
          "sequence",
          "expectedRevision",
          "occurredAt",
          "modelVersion",
          "schemaVersion",
          "payloadHash",
          "command"
        ]
      },
      "EventBatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        },
        "required": [
          "requestId",
          "events"
        ]
      },
      "EventAck": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate",
              "missing_predecessor",
              "conflict",
              "unsupported_version",
              "rejected"
            ]
          },
          "revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "eventId",
          "status",
          "revision",
          "code"
        ]
      },
      "BatchAck": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventAck"
            }
          }
        },
        "required": [
          "requestId",
          "results"
        ]
      }
    }
  }
}
